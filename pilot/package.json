{
  "name": "claude-pilot",
  "version": "0.1.0",
  "description": "Resilient Claude Code session manager with WhatsApp integration",
  "type": "module",
  "bin": {
    "pilot": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "session-manager",
    "tmux",
    "whatsapp",
    "cli",
    "resilient",
    "daemon"
  ],
  "author": "Eli Hundia <eli.hundia@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "date-fns": "^3.6.0",
    "fs-extra": "^11.2.0",
    "ioredis": "^5.4.0",
    "nanoid": "^5.0.0",
    "ora": "^8.0.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
