# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://mealmap:mealmap_dev@localhost:5432/mealmap

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-min-32-characters-here
